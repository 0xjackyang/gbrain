# GBrain E2E Test Configuration
# Copy to .env.testing and fill in real values
#
# Tier 1 (required for destructive E2E tests)
# IMPORTANT: use the dedicated E2E env var. Ambient DATABASE_URL is ignored on
# purpose so `DATABASE_URL=$GBRAIN_DATABASE_URL bun test ...` cannot hit prod.
# Option A: Local Docker Postgres (default)
GBRAIN_E2E_DATABASE_URL=postgresql://postgres:***@localhost:5433/gbrain_test
# Option B: Dedicated remote test database (only if it is truly isolated)
# GBRAIN_E2E_DATABASE_URL=postgresql://postgres.[project-ref]:***@aws-0-us-east-1.pooler.supabase.com:6543/gbrain_test
# If you must target a database whose name does not look like test/e2e/ci/tmp,
# set this explicitly for that run and double-check isolation first:
# GBRAIN_E2E_ALLOW_ANY_DB=1

# Tier 2 (required for skill tests, optional for mechanical tests)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
